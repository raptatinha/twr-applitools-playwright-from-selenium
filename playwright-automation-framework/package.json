{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --headed",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:test": "ENVIRONMENT='TEST' BE_BRANCH='main' FE_BRANCH='main' npx playwright test",
    "test:stage": "ENVIRONMENT='STAGE' npx playwright test",
    "test:prod": "ENVIRONMENT='PROD' npx playwright test",
    "test:last-failed": "npx playwright test --last-failed",
    "report": "npx playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@playwright/test": "1.48.1",
    "@slack/types": "^2.12.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "maskdata": "^1.3.1",
    "playwright-slack-report": "^1.1.88",
    "prettier": "3.3.3",
    "typescript": "^5.6.3"
  }
